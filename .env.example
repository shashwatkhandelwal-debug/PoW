# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Target Upstream API
TARGET_URL=http://target_app:8000
MIDDLEWARE_PORT=8080

# Cryptography (Generate a random 32+ byte hex secret in production)
HMAC_SECRET_KEY=insecure-dev-secret-change-in-production-32bytes-min

# Challenge Configuration
CHALLENGE_TTL_SECONDS=60
WORK_CREDIT_TTL_SECONDS=300
DEFAULT_DIFFICULTY_BITS=8
POW_ALGORITHM=sha256

# Scoring Worker
SCORING_INTERVAL_MS=500
SCORING_LAG_SECONDS=0.5
